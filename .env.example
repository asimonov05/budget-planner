# По умолчанию приложение доступно только с этого компьютера.
BIND_HOST=127.0.0.1
APP_PORT=8082
APP_IMAGE_TAG=local

# PostgreSQL запускается внутри Compose без открытого порта.
# Перед первым запуском создайте .secrets/postgres-password и
# .secrets/postgres-runtime-password и .secrets/postgres-debug-admin-password
# с разными случайными паролями.

# Host-заголовки через запятую. Для LAN добавьте IP/имя сервера явно.
TRUSTED_HOSTS=127.0.0.1,localhost

# Установите 1 только когда приложение открывается через HTTPS reverse proxy.
SESSION_COOKIE_SECURE=0

# Включает отладочную админку (доступна только после входа владельца).
DEBUG_ADMIN_ENABLED=0

# IP reverse proxy, от которого Uvicorn может доверять X-Forwarded-*.
# Не ставьте *, если порт приложения доступен не только прокси.
FORWARDED_ALLOW_IPS=127.0.0.1
